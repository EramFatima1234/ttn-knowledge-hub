# KnowledgeHub API
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000
ALLOWED_EMAIL_DOMAIN=tothenew.com

# Database
DATABASE_URL=postgresql://knowledgehub:knowledgehub@localhost:5432/knowledgehub?schema=public

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Storage (LOCAL | S3)
# LOCAL: files saved under STORAGE_LOCAL_PATH and served from STORAGE_PUBLIC_URL_PREFIX
# S3: set STORAGE_PROVIDER=S3 and configure bucket credentials below
STORAGE_PROVIDER=LOCAL
STORAGE_LOCAL_PATH=./storage
STORAGE_PUBLIC_URL_PREFIX=/storage

# AWS S3 (production)
AWS_S3_BUCKET=
AWS_S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=

# Search (postgres | elasticsearch)
SEARCH_PROVIDER=postgres
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=knowledgehub_content

# Mail (console | smtp)
MAIL_PROVIDER=console
MAIL_FROM=KnowledgeHub <noreply@tothenew.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Web push (console | webpush)
PUSH_PROVIDER=console
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:knowledgehub@tothenew.com

# AI (gemini | openai | ollama — only gemini implemented today)
# Create key: https://aistudio.google.com/apikey — must start with AIza (not GOOGLE_CLIENT_ID)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
